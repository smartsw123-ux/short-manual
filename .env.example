# ─── Supabase ───────────────────────────────────────────────
# Supabase 프로젝트 > Settings > API 에서 복사
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service_role (secret) 키 — 서버에서만 사용, 절대 공개 금지

# ─── Anthropic (Claude) ─────────────────────────────────────
# https://console.anthropic.com/ > API Keys
ANTHROPIC_API_KEY=sk-ant-...
# 사용할 모델 (기본값 있음, 바꾸고 싶을 때만 설정)
ANTHROPIC_MODEL=claude-sonnet-5

# ─── 앱 설정 ────────────────────────────────────────────────
# Supabase Storage 버킷 이름 (기본: manuals)
SUPABASE_MANUALS_BUCKET=manuals
