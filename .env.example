# ─── Supabase ───────────────────────────────────────────────
# Supabase 프로젝트 > Settings > API 에서 복사
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...   # secret 키 — 서버에서만 사용, 절대 공개 금지

# ─── Google Gemini (무료 등급) ──────────────────────────────
# https://aistudio.google.com/apikey  (카드 등록 불필요)
GEMINI_API_KEY=AIza...
# 사용할 모델 (기본값 있음, 바꾸고 싶을 때만)
GEMINI_MODEL=gemini-2.5-flash

# ─── 앱 설정 ────────────────────────────────────────────────
SUPABASE_MANUALS_BUCKET=manuals
